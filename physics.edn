;; What this vertical's robot physically does, declared for
;; kotoba.robotics.process (kotoba-lang/robotics). `kbb -M:physics` runs it.
;;
;; README "Robotics premise": a workshop scheduling/logistics coordination
;; robot schedules the upholstery crew, logs commissions and coordinates
;; padding/fabric/frame supply; it never upholsters. Its physical work is
;; moving bulky items: carrying sofa/chair frames to the bench and lifting
;; foam blocks onto the cutting table.
;;
;; Every number without a cited source is marked `estimate` in its :basis.
;; Replacing an estimate with a sourced value is this bot's growth work.
{:physics/schema "itonami.physical-ai.spec.v1"
 :repo "cloud-itonami/cloud-itonami-isco-7534"
 :cases
 [{:id :frame-dolly-to-bench
   :kind :transport
   :procedure "dolly carries a sofa frame standing on end from the frame store to the upholstery bench"
   :params {:mass-kg 50.0 :distance-m 25.0 :v-max-mps 0.8 :a-max-mps2 0.5
            :brake-decel-mps2 2.0 :drive-force-n 150.0 :crr 0.02
            :cog-height-m 0.25 :support-half-length-m 0.25
            :payload-kg 40.0 :max-time-s 600.0}
   :sweep {:param :payload-cog-height-m :values [0.5 0.8 1.1 1.4 1.7]}
   :quantity :min-tipover-margin
   :limit {:min 0.3 :basis "estimate: 30 % tip-over reserve for a tall frame when the dolly makes an emergency stop at 2 m/s²"}
   :boundary {:lo 0.3 :hi 2.0}}
  {:id :foam-block-to-cutting-table
   :kind :manipulator
   :procedure "arm lifts a foam block or fabric roll from the store shelf onto the cutting table"
   :params {:l1-m 0.55 :l2-m 0.50 :m1-kg 6.0 :m2-kg 4.0
            :from [0.40 0.80] :to [0.75 0.10] :duration-s 2.5 :steps 500}
   :sweep {:param :payload-kg :values [2.0 5.0 8.0 12.0 16.0]}
   :quantity :peak-tau1-nm
   :limit {:max 120.0 :basis "estimate: continuous shoulder torque of a ~10 kg-class collaborative arm"}
   :boundary {:lo 0.5 :hi 60.0}}]}
